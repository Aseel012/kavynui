# Copy to .env (local) or add in Vercel → Project → Settings → Environment Variables.
# Everything prefixed VITE_ is bundled into the browser code. NEVER put secrets here.

# Your live domain, used for the sitemap and robots.txt. https only, no trailing slash.
VITE_SITE_URL=https://www.kavynui.com

# Public GitHub repo. Leave empty to show the GitHub icon as "coming soon".
VITE_GITHUB_URL=https://github.com/Aseel012/kavynUI

# Sponsor wall (home page): empty "Your logo here" tiles email SITE.sponsorEmail (src/config.js).
# Set this only to send them somewhere else instead, e.g. a GitHub Sponsors page.
VITE_SPONSOR_URL=

# Product events (which component gets copied or installed from the site).
# Vercel Web Analytics only stores custom events on paid plans. PostHog's free tier works:
# create a project at posthog.com and paste its Project API key here (it is a public key).
VITE_POSTHOG_KEY=
# Only if your PostHog project is in the EU region: https://eu.i.posthog.com
VITE_POSTHOG_HOST=
