# Copy to .env (local) or add in Vercel → Project → Settings → Environment Variables.
# Everything prefixed VITE_ is bundled into the browser code. NEVER put secrets here.

# Your live domain, used for the sitemap and robots.txt. https only, no trailing slash.
VITE_SITE_URL=http://kavynui.com

# Public GitHub repo. Leave empty to show the GitHub icon as "coming soon".
VITE_GITHUB_URL=https://github.com/Aseel012/kavynUI
