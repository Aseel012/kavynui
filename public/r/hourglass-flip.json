{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "hourglass-flip",
  "title": "Hourglass Flip",
  "type": "registry:component",
  "description": "Sand drains, glass flips",
  "dependencies": [
    "motion@^12.43.0"
  ],
  "files": [
    {
      "path": "src/kavyn/hourglass-flip.jsx",
      "type": "registry:file",
      "target": "@components/kavyn/hourglass-flip.jsx",
      "content": "'use client'\n\nimport { useEffect, useState } from 'react'\nimport { motion } from 'motion/react'\n\nexport default function HourglassFlip({ seconds = 2.4, position = 12 }) {\n  const [flip, setFlip] = useState(0)\n  useEffect(() => { const t = setInterval(() => setFlip((f) => f + 1), seconds * 1000 + 700); return () => clearInterval(t) }, [seconds])\n  return (\n    <div className=\"flex items-center gap-5\">\n      <motion.svg viewBox=\"0 0 40 60\" className=\"h-20 w-14\" animate={{ rotate: flip * 180 }} transition={{ type: 'spring', stiffness: 200, damping: 14 }}>\n        <path d=\"M6 4 H34 M6 56 H34\" stroke=\"#ededef\" strokeWidth=\"2.5\" strokeLinecap=\"round\" />\n        <path d=\"M9 6 C9 20, 31 22, 31 6 Z M9 54 C9 40, 31 38, 31 54 Z\" fill=\"none\" stroke=\"#5c5c66\" strokeWidth=\"1.5\" />\n        <path d=\"M9 6 C9 20, 20 28, 20 30 C20 28, 31 20, 31 6 M9 54 C9 40, 20 32, 20 30 C20 32, 31 40, 31 54\" fill=\"none\" stroke=\"#5c5c66\" strokeWidth=\"1.5\" />\n        <clipPath id=\"hg-top\"><path d=\"M9 6 C9 20, 20 28, 20 30 C20 28, 31 20, 31 6 Z\" /></clipPath>\n        <clipPath id=\"hg-bot\"><path d=\"M9 54 C9 40, 20 32, 20 30 C20 32, 31 40, 31 54 Z\" /></clipPath>\n        <g clipPath={flip % 2 ? 'url(#hg-bot)' : 'url(#hg-top)'}>\n          <motion.rect key={'t' + flip} x=\"0\" width=\"40\" height=\"30\" fill=\"#ff6a2b\" initial={{ y: flip % 2 ? 30 : 0 }} animate={{ y: flip % 2 ? 60 : 30 }} transition={{ duration: seconds, ease: 'linear' }} />\n        </g>\n        <g clipPath={flip % 2 ? 'url(#hg-top)' : 'url(#hg-bot)'}>\n          <motion.rect key={'b' + flip} x=\"0\" width=\"40\" height=\"30\" fill=\"#ff6a2b\" initial={{ y: flip % 2 ? -30 : 60 }} animate={{ y: flip % 2 ? 0 : 30 }} transition={{ duration: seconds, ease: 'linear' }} />\n        </g>\n        <motion.line key={'s' + flip} x1=\"20\" x2=\"20\" y1=\"28\" y2=\"50\" stroke=\"#ff6a2b\" strokeWidth=\"1\" initial={{ opacity: 1 }} animate={{ opacity: 0 }} transition={{ delay: seconds - 0.2, duration: 0.2 }} style={{ transformOrigin: '20px 30px', rotate: flip % 2 ? 180 : 0 }} />\n      </motion.svg>\n      <div>\n        <div className=\"text-xs text-faint\">Your place in line</div>\n        <div className=\"font-mono text-3xl text-tx\">#{Math.max(1, position - flip)}</div>\n      </div>\n    </div>\n  )\n}\n"
    }
  ],
  "cssVars": {
    "theme": {
      "color-bg": "var(--bg)",
      "color-panel": "var(--panel)",
      "color-panel2": "var(--panel2)",
      "color-line": "var(--line)",
      "color-line2": "var(--line2)",
      "color-tx": "var(--tx)",
      "color-mute": "var(--mute)",
      "color-faint": "var(--faint)",
      "color-acc": "var(--acc)"
    },
    "light": {
      "bg": "#fafafa",
      "panel": "#ffffff",
      "panel2": "#f0f0f3",
      "line": "#e6e6ea",
      "line2": "#d6d6dd",
      "tx": "#141417",
      "mute": "#5f5f6b",
      "faint": "#a2a2ab",
      "acc": "#e14e0b"
    },
    "dark": {
      "bg": "#09090a",
      "panel": "#0f0f11",
      "panel2": "#141417",
      "line": "#1e1e22",
      "line2": "#2a2a30",
      "tx": "#ededef",
      "mute": "#8a8a93",
      "faint": "#5c5c66",
      "acc": "#ff6a2b"
    }
  },
  "css": {
    ".light": {
      "--bg": "#fafafa",
      "--panel": "#ffffff",
      "--panel2": "#f0f0f3",
      "--line": "#e6e6ea",
      "--line2": "#d6d6dd",
      "--tx": "#141417",
      "--mute": "#5f5f6b",
      "--faint": "#a2a2ab",
      "--acc": "#e14e0b"
    }
  }
}
