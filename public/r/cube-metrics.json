{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "cube-metrics",
  "title": "Cube Metrics",
  "type": "registry:component",
  "description": "KPI cube rolls face to face",
  "dependencies": [
    "motion@^12.43.0"
  ],
  "files": [
    {
      "path": "src/kavyn/cube-metrics.jsx",
      "type": "registry:file",
      "target": "@components/kavyn/cube-metrics.jsx",
      "content": "'use client'\n\nimport { useEffect, useState } from 'react'\nimport { motion } from 'motion/react'\n\nconst KPIS = [\n  { k: 'Active users', v: '12,480', d: '+8.2%' }, { k: 'MRR', v: '₹9.4L', d: '+3.1%' },\n  { k: 'Churn', v: '1.8%', d: '-0.4%' }, { k: 'NPS', v: '62', d: '+5' },\n]\nconst S = 176\n\nexport default function CubeMetrics({ kpis = KPIS, every = 2400 }) {\n  const [i, setI] = useState(0)\n  useEffect(() => { const t = setInterval(() => setI((x) => x + 1), every); return () => clearInterval(t) }, [every])\n  return (\n    <div className=\"flex flex-col items-center gap-5\">\n      <div className=\"[perspective:800px]\" style={{ width: S, height: S }}>\n        <motion.div className=\"relative size-full\" style={{ transformStyle: 'preserve-3d' }} animate={{ rotateX: i * -90 }} transition={{ type: 'spring', stiffness: 90, damping: 14 }}>\n          {kpis.map((m, f) => (\n            <div key={f} className=\"absolute inset-0 flex flex-col justify-between rounded-2xl border border-line2 bg-panel2 p-5\" style={{ transform: `rotateX(${f * 90}deg) translateZ(${S / 2}px)`, backfaceVisibility: 'hidden' }}>\n              <span className=\"text-xs uppercase tracking-widest text-faint\">{m.k}</span>\n              <span className=\"text-4xl font-medium tracking-tight text-tx\">{m.v}</span>\n              <span className={`font-mono text-xs ${m.d.startsWith('-') && m.k !== 'Churn' ? 'text-red-400' : 'text-emerald-400'}`}>{m.d} this week</span>\n            </div>\n          ))}\n        </motion.div>\n      </div>\n      <div className=\"flex gap-1.5\">{kpis.map((_, f) => <motion.button key={f} onClick={() => setI(f + Math.floor(i / kpis.length) * kpis.length)} animate={{ width: i % kpis.length === f ? 18 : 6, backgroundColor: i % kpis.length === f ? '#ff6a2b' : '#2a2a30' }} className=\"h-1.5 rounded-full\" />)}</div>\n    </div>\n  )\n}\n"
    }
  ],
  "cssVars": {
    "theme": {
      "color-bg": "var(--bg)",
      "color-panel": "var(--panel)",
      "color-panel2": "var(--panel2)",
      "color-line": "var(--line)",
      "color-line2": "var(--line2)",
      "color-tx": "var(--tx)",
      "color-mute": "var(--mute)",
      "color-faint": "var(--faint)",
      "color-acc": "var(--acc)"
    },
    "light": {
      "bg": "#fafafa",
      "panel": "#ffffff",
      "panel2": "#f0f0f3",
      "line": "#e6e6ea",
      "line2": "#d6d6dd",
      "tx": "#141417",
      "mute": "#5f5f6b",
      "faint": "#a2a2ab",
      "acc": "#e14e0b"
    },
    "dark": {
      "bg": "#09090a",
      "panel": "#0f0f11",
      "panel2": "#141417",
      "line": "#1e1e22",
      "line2": "#2a2a30",
      "tx": "#ededef",
      "mute": "#8a8a93",
      "faint": "#5c5c66",
      "acc": "#ff6a2b"
    }
  },
  "css": {
    ".light": {
      "--bg": "#fafafa",
      "--panel": "#ffffff",
      "--panel2": "#f0f0f3",
      "--line": "#e6e6ea",
      "--line2": "#d6d6dd",
      "--tx": "#141417",
      "--mute": "#5f5f6b",
      "--faint": "#a2a2ab",
      "--acc": "#e14e0b"
    }
  }
}
