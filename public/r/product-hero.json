{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "product-hero",
  "title": "Product Hero",
  "type": "registry:block",
  "description": "Headline and actions beside an app window running a deploy",
  "dependencies": [
    "motion@^12.43.0"
  ],
  "files": [
    {
      "path": "src/kavyn/product-hero.jsx",
      "type": "registry:file",
      "target": "@components/kavyn/product-hero.jsx",
      "content": "'use client'\n\nimport { useEffect, useState } from 'react'\nimport { motion, AnimatePresence } from 'motion/react'\n\nconst LOG = [\n  ['›', 'Cloning repository', 'text-mute'], ['›', 'Installing dependencies', 'text-mute'], ['›', 'Building 41 routes', 'text-mute'],\n  ['✓', 'Build complete in 18.2s', 'text-emerald-400'], ['›', 'Uploading to 300 edge locations', 'text-mute'], ['✓', 'Live at example.com', 'text-acc'],\n]\n\n// Block: product hero. Headline, two actions, and an app window that runs a real-looking deploy.\nexport default function ProductHero({ title = 'Ship the site. Skip the servers.', sub = 'Push to main and it is live everywhere in under a minute.', primary = 'Start deploying', secondary = 'Read the docs' }) {\n  const [n, setN] = useState(0)\n  useEffect(() => {\n    const id = setInterval(() => !document.hidden && setN((x) => (x >= LOG.length + 3 ? 0 : x + 1)), 700)\n    return () => clearInterval(id)\n  }, [])\n  const done = n >= LOG.length\n  return (\n    <section className=\"@container relative w-full overflow-hidden rounded-2xl border border-line bg-bg\">\n      <div className=\"pointer-events-none absolute inset-0 bg-[radial-gradient(60%_50%_at_50%_0%,rgba(255,106,43,.14),transparent)]\" />\n      <div className=\"relative grid items-center gap-10 p-6 @4xl:grid-cols-2 @4xl:p-12\">\n        <div>\n          <motion.h2 initial={{ opacity: 0, y: 12 }} animate={{ opacity: 1, y: 0 }} className=\"text-3xl font-semibold tracking-[-0.035em] text-tx @2xl:text-5xl\">{title}</motion.h2>\n          <motion.p initial={{ opacity: 0, y: 12 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.08 }} className=\"mt-4 max-w-md text-mute\">{sub}</motion.p>\n          <motion.div initial={{ opacity: 0, y: 12 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.16 }} className=\"mt-7 flex flex-wrap gap-3\">\n            <button type=\"button\" className=\"h-10 rounded-full bg-tx px-5 text-sm font-medium text-bg transition-transform active:scale-95\">{primary}</button>\n            <button type=\"button\" className=\"h-10 rounded-full border border-line2 px-5 text-sm text-mute hover:text-tx\">{secondary}</button>\n          </motion.div>\n        </div>\n        <motion.div initial={{ opacity: 0, y: 24, rotateX: 12 }} animate={{ opacity: 1, y: 0, rotateX: 0 }} transition={{ type: 'spring', stiffness: 120, damping: 20 }}\n          className=\"overflow-hidden rounded-xl border border-line2 bg-panel shadow-[0_30px_80px_-20px_rgba(0,0,0,.8)]\" style={{ transformPerspective: 900 }}>\n          <div className=\"flex items-center gap-1.5 border-b border-line px-3 py-2.5\">\n            <span className=\"size-2.5 rounded-full bg-line2\" /><span className=\"size-2.5 rounded-full bg-line2\" /><span className=\"size-2.5 rounded-full bg-line2\" />\n            <span className=\"ml-3 truncate font-mono text-[11px] text-faint\">deploy · main@8f3c21a</span>\n          </div>\n          <div className=\"h-52 space-y-1.5 p-4 font-mono text-xs\">\n            <AnimatePresence>\n              {LOG.slice(0, n).map(([ic, t, c]) => (\n                <motion.div key={t} initial={{ opacity: 0, x: -8 }} animate={{ opacity: 1, x: 0 }} exit={{ opacity: 0 }} className={`flex gap-2 ${c}`}><span>{ic}</span><span>{t}</span></motion.div>\n              ))}\n            </AnimatePresence>\n          </div>\n          <div className=\"h-1 bg-line\"><motion.div className=\"h-full bg-acc\" animate={{ width: `${Math.min(1, n / LOG.length) * 100}%` }} transition={{ type: 'spring', stiffness: 80, damping: 20 }} /></div>\n          <div className=\"flex items-center justify-between px-4 py-2.5 text-[11px]\">\n            <span className={done ? 'text-emerald-400' : 'text-mute'}>{done ? 'Ready' : 'Building…'}</span>\n            <span className=\"font-mono text-faint\">{Math.min(n, LOG.length)}/{LOG.length}</span>\n          </div>\n        </motion.div>\n      </div>\n    </section>\n  )\n}\n"
    }
  ],
  "cssVars": {
    "theme": {
      "color-bg": "var(--bg)",
      "color-panel": "var(--panel)",
      "color-panel2": "var(--panel2)",
      "color-line": "var(--line)",
      "color-line2": "var(--line2)",
      "color-tx": "var(--tx)",
      "color-mute": "var(--mute)",
      "color-faint": "var(--faint)",
      "color-acc": "var(--acc)"
    },
    "light": {
      "bg": "#fafafa",
      "panel": "#ffffff",
      "panel2": "#f0f0f3",
      "line": "#e6e6ea",
      "line2": "#d6d6dd",
      "tx": "#141417",
      "mute": "#5f5f6b",
      "faint": "#a2a2ab",
      "acc": "#e14e0b"
    },
    "dark": {
      "bg": "#09090a",
      "panel": "#0f0f11",
      "panel2": "#141417",
      "line": "#1e1e22",
      "line2": "#2a2a30",
      "tx": "#ededef",
      "mute": "#8a8a93",
      "faint": "#5c5c66",
      "acc": "#ff6a2b"
    }
  },
  "css": {
    ".light": {
      "--bg": "#fafafa",
      "--panel": "#ffffff",
      "--panel2": "#f0f0f3",
      "--line": "#e6e6ea",
      "--line2": "#d6d6dd",
      "--tx": "#141417",
      "--mute": "#5f5f6b",
      "--faint": "#a2a2ab",
      "--acc": "#e14e0b"
    }
  }
}
